# ==========================================
# SMTP GENERATOR BOT - CONFIGURATION EXAMPLE
# ==========================================

# 1. CORE BOT CONFIGURATIONS
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ADMIN_IDS=your_chat_id_here,any_other_admin_chat_id_here
TESTIMONIAL_CHANNEL_ID=your_testimonial_channel_id_here

# 2. IVASMS API CONFIGURATIONS
IVASMS_EMAIL=your_ivasms_email_here
IVASMS_PASSWORD=your_ivasms_password_here

# 3. WA CHECKER URL (Local Express Server)
# Default is http://localhost:3000 if running on the same container
WA_CHECKER_URL=http://localhost:3000

# 4. MAILERSEND API CONFIGURATIONS (For Unban Appeals)
MAILERSEND_API_KEY=mlsn.your_mailersend_api_key_here
MAILERSEND_SENDER_EMAIL=your_verified_domain_email_here@yourdomain.com

# 5. OPENCODE AI SELF-IMPROVEMENT AGENT
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_MODEL=opencode/deepseek-v4-flash-free

# 6. CPANEL GENERATOR API CONFIGURATIONS (Optional)
CPANEL_API_URL=https://your_cpanel_host_or_ip:2083
CPANEL_API_KEY=your_cpanel_api_token_here
CPANEL_URL=https://your_cpanel_domain_or_ip
CPANEL_USER=your_cpanel_username
CPANEL_PASS=your_cpanel_password
CPANEL_DOMAIN=your_cpanel_domain.com

# 7. OTP FORWARDER API CONFIGURATIONS (SMS activation)
XCLUSOR_API_KEY=your_xclusor_api_key_here
XCLUSOR_API_URL=https://api.sms-activate.org/steward.php

# 8. GITHUB AUTO-SYNC STORAGE (Optional)
# If set, bot will push updated session databases back to your GitHub repo
GH_PAT=
GITHUB_REPOSITORY=
